# ── Скопируй в .env и заполни своими данными ──

# Порт, на котором работает API
PORT=3001

# Откуда разрешены запросы (домен сайта). Через запятую можно несколько.
ALLOWED_ORIGINS=http://localhost:5173,https://твой-домен.ru

# ── SMTP сервера (почта, с которой ОТПРАВЛЯЮТСЯ письма) ──
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@твой-домен.ru
SMTP_PASS=пароль_от_почты

# От кого приходит письмо (обычно тот же SMTP_USER)
MAIL_FROM="Сайт Надежды <noreply@твой-домен.ru>"

# ── Куда ПРИХОДЯТ заявки (можно указать позже) ──
MAIL_TO=куда-слать-заявки@example.com

# ── Stripe: продажа гайда на сайте ──
# Адрес сайта (для ссылок после оплаты и в письме)
SITE_URL=https://nadezdantiage.com
# Секретный ключ: dashboard.stripe.com → Developers → API keys (sk_live_... / sk_test_...)
STRIPE_SECRET_KEY=sk_test_...
# Секрет вебхука: Developers → Webhooks → endpoint https://nadezdantiage.com/api/stripe/webhook
# события: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=whsec_...
# (необязательно) ID цены из Stripe; если пусто — $7.99
STRIPE_PRICE_ID=
# Путь к PDF гайда на сервере (НЕ в public!). По умолчанию server/private/guide.pdf
GUIDE_PDF_PATH=

# ── Lemon Squeezy: оплата гайда (если всё задано — используется вместо Stripe) ──
# app.lemonsqueezy.com → Settings → API (ключ test mode для проверки, live — для продажи)
LEMONSQUEEZY_API_KEY=
# ID магазина: Settings → Stores
LEMONSQUEEZY_STORE_ID=
# ID вариантов двух товаров (PDF и онлайн-версия): Products → товар → вариант
LEMONSQUEEZY_VARIANT_PDF=
LEMONSQUEEZY_VARIANT_WEB=
# Секрет вебхука https://nadezdantiage.com/api/lemonsqueezy/webhook, событие order_created
LEMONSQUEEZY_WEBHOOK_SECRET=
# true — принимать заказы test mode (только на время проверки!), на боевом режиме оставить пустым
LEMONSQUEEZY_ALLOW_TEST=

# ── Resend (отправка писем по HTTPS, если хостинг блокирует SMTP) ──
# resend.com → API Keys. Если задан — письма идут через Resend, SMTP_* не используются.
RESEND_API_KEY=
# MAIL_FROM тогда должен быть на подтверждённом домене, например:
# MAIL_FROM="Надежда Праворова <noreply@nadezdantiage.com>"
